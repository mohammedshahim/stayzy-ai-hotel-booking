PORT=4000
# Number of proxy hops in front of Express, 0 in dev. Set it to the real count or
# the IP-keyed aiRateLimit is either disabled or forgeable — see architecture.md.
TRUST_PROXY=0
APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DATABASE_URL=postgresql://user:password@localhost:5432/stayzy

BETTER_AUTH_SECRET=
BETTER_AUTH_ADMIN_SECRET=
# Leave empty in dev. In production set it to the shared parent domain (".example.com")
# or the session cookie never reaches the API subdomain — see architecture.md.
COOKIE_DOMAIN=

ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CRON_SECRET=
BOOKING_EXPIRY_MINUTES=20

# Required. Must match agent/.env exactly.
INTERNAL_SERVICE_SECRET=
INTERNAL_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_RATE_LIMIT_MAX=120

# Where agent/ listens. backend/ is the only service that calls it.
AGENT_BASE_URL=http://localhost:4100
# Public AI routes, keyed on IP. Needs `trust proxy` in production — see architecture.md.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
# A browser waits on this one; the seed script uses the longer budget instead.
AI_REQUEST_TIMEOUT_MS=45000
AI_SEED_TIMEOUT_MS=300000
# The chat widget is logged-in only, so this one is keyed on the user, not IP.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=15

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAPBOX_ACCESS_TOKEN=
GEOCODING_PROVIDER=mapbox
