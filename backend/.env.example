# Required. Must match agent/.env exactly.
INTERNAL_SERVICE_SECRET=
INTERNAL_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_RATE_LIMIT_MAX=120

# Where agent/ listens. backend/ is the only service that calls it.
AGENT_BASE_URL=http://localhost:4100
# Public AI routes, keyed on IP. Needs `trust proxy` in production — see architecture.md.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
# A browser waits on this one; the seed script uses the longer budget instead.
AI_REQUEST_TIMEOUT_MS=20000
AI_SEED_TIMEOUT_MS=300000

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAPBOX_ACCESS_TOKEN=
