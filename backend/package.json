{
  "name": "stayzy-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "drizzle-kit migrate",
    "migrate:down": "tsx src/config/migrate-down.ts",
    "seed": "tsx src/config/seed.ts",
    "seed:admin": "tsx src/config/seed-admin.ts",
    "seed:ai-summaries": "tsx src/config/seed-ai-summaries.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "better-auth": "^1.2.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "resend": "^6.17.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
