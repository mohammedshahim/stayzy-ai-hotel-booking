# agent/ — Stayzy AI agent service
# Copy to .env and fill in. Every variable without a default is required at startup.

# Port the FastAPI app listens on. 4000/3000/5173 are taken by the other three apps.
PORT=4100

# Same database as backend/'s DATABASE_URL. The checkpointer's tables are
# isolated into their own schema (see CHECKPOINTER_SCHEMA), so they never
# collide with Drizzle's tables or its drizzle.__drizzle_migrations ledger.
# Required — no localhost default, so an unset value in production fails loudly.
AGENT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/stayzy
CHECKPOINTER_SCHEMA=agent

# backend/ is the only service agent/ ever calls.
BACKEND_INTERNAL_URL=http://localhost:4000

# Shared secret, identical to backend/'s INTERNAL_SERVICE_SECRET.
# Consumed by requireInternalService.ts (Feature 37). Never reaches a frontend.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=replace-me

# OpenRouter. This key lives only here — never in backend/, never in a browser.
# Feature 36 makes no LLM call, so a placeholder boots fine; Feature 38 needs a real key.
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model per use case, never hardcoded at a call site. Both are the same free
# model for now; raise the smart one for the chatbot's tool loop later.
OPENROUTER_MODEL_FAST=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b:free
